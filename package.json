{
  "name": "plotforge",
  "version": "1.1.0",
  "description": "Local-first AI-assisted novel writing studio (React + Express + sql.js)",
  "main": "server/index.js",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/1while1/Plotforge.git"
  },
  "keywords": [
    "novel-writing",
    "ai-writing",
    "llm",
    "local-first",
    "writing-tool"
  ],
  "scripts": {
    "start": "node server/index.js",
    "dev": "vite",
    "build": "vite build",
    "test": "node --test --test-concurrency=1 test/*.test.js test/api/*.test.js",
    "test:fe": "vitest run",
    "test:e2e": "node tools/e2e-test.js",
    "test:db": "node --test --test-concurrency=1 test/db-migrations.test.js",
    "seed": "node tools/seed-demo.js",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^2.0.67",
    "@xenova/transformers": "^2.17.2",
    "ai": "^6.0.253",
    "express": "^5.2.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "sql.js": "^1.14.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@vitejs/plugin-react": "^6.1.1",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.5.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "lint-staged": {
    "frontend/**/*": [
      "npx biome check --no-errors-on-unmatched"
    ],
    "tools/**/*": [
      "npx biome check --no-errors-on-unmatched"
    ],
    "test/**/*": [
      "npx biome check --no-errors-on-unmatched"
    ]
  }
}
