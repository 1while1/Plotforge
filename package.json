{
  "name": "plotforge",
  "version": "1.0.0",
  "description": "Local-first AI-assisted novel writing studio (Node.js + Express + sql.js)",
  "main": "server/index.js",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/1while1/Plotforge.git"
  },
  "keywords": [
    "novel-writing",
    "ai-writing",
    "llm",
    "local-first",
    "writing-tool"
  ],
  "scripts": {
    "start": "node server/index.js",
    "test": "node --test --test-concurrency=1 test/*.test.js test/api/*.test.js",
    "test:e2e": "node tools/e2e-test.js",
    "test:db": "node --test --test-concurrency=1 test/db-migrations.test.js",
    "seed": "node tools/seed-demo.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^2.0.67",
    "@xenova/transformers": "^2.17.2",
    "ai": "^6.0.253",
    "express": "^5.2.1",
    "sql.js": "^1.14.1",
    "zod": "^4.4.3"
  }
}
